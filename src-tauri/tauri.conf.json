{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexium Studio",
  "version": "0.1.0",
  "identifier": "com.nexium.studio",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexium Studio",
        "decorations": false,
        "center": true,
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
